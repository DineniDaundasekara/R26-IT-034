# -----------------------------
# Local Whisper
# -----------------------------
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# -----------------------------
# OpenAI guidance generation
# Keep this key ONLY in backend/.env
# Never place the key in React/Vite source code.
# -----------------------------
OPENAI_GUIDANCE_ENABLED=true
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_GUIDANCE_MODEL=gpt-5.6-sol

# Optional second-pass factual grounding verification (recommended for panel/demo)
OPENAI_GUIDANCE_VERIFY=true
OPENAI_VERIFIER_MODEL=gpt-5.6-sol
